{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gears-clash.local/schemas/gameConfig.json",
  "title": "GearsClashGameConfig",
  "description": "Strukturierte, JSON-serialisierbare Konfiguration für das Gears-Clash-Slot-Game. Auszahlungen, Bonus-Ergebnisse und finale Gewinne sind serverseitig — diese Konfiguration steuert nur Darstellung, Symbol-Definition und Animations-Parameter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grid",
    "symbols",
    "symbolWeights",
    "payoutTable",
    "bonusTriggers",
    "multiplierRanges",
    "freeSpinDefaults",
    "maxWin",
    "animation",
    "assets",
    "sound"
  ],
  "properties": {
    "version": {
      "description": "Optionaler Schema-Versions-Marker (frei wählbar, z. B. \"1.0\").",
      "type": "string"
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reels", "rows"],
      "properties": {
        "reels": { "type": "integer", "minimum": 1, "maximum": 10 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["normal", "wild", "bonus"] },
          "label": { "type": "string" },
          "bonusId": {
            "type": "string",
            "enum": ["gears_clash", "heist_run", "deadlock_mode"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "bonus" } },
              "required": ["kind"]
            },
            "then": {
              "required": ["bonusId"]
            }
          },
          {
            "if": {
              "properties": { "kind": { "not": { "const": "bonus" } } },
              "required": ["kind"]
            },
            "then": {
              "not": { "required": ["bonusId"] }
            }
          }
        ]
      }
    },
    "symbolWeights": {
      "description": "Map symbol-id → Gewicht (>= 0). Server kann die Werte ableiten; Client nutzt sie nur für Mock-Generierung.",
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "payoutTable": {
      "description": "Auszahlungstabelle als Referenz / Anzeige. Finale Gewinne kommen vom Server.",
      "type": "object"
    },
    "bonusTriggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bonusSymbolIds"],
      "properties": {
        "bonusSymbolIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "multiplierRanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "freeSpinDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "maxWin": { "type": "number", "minimum": 0 },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spinDurationMs", "reelStopStaggerMs"],
      "properties": {
        "spinDurationMs": { "type": "integer", "minimum": 0 },
        "reelStopStaggerMs": { "type": "integer", "minimum": 0 },
        "turbo": { "type": "boolean" },
        "reelSequentialDurationMs": { "type": "integer", "minimum": 200 },
        "reelApproachExtraRows": { "type": "integer", "minimum": 0, "maximum": 20 },
        "reelIdleScrollRowsPerSec": { "type": "number", "minimum": 0, "maximum": 40 },
        "scatterAnticipationPendingReelSpeedMul": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 3
        },
        "scatterAnticipationIdleRampMs": {
          "type": "number",
          "minimum": 40,
          "maximum": 3000
        },
        "scatterAnticipationSequentialStopStretch": {
          "type": "number",
          "minimum": 1,
          "maximum": 2.2
        },
        "scatterAnticipationTerminalSlowFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.45
        },
        "scatterAnticipationTurboExtraStopMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 8000
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basePath"],
      "properties": {
        "basePath": { "type": "string" }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "baseUrl": { "type": "string" }
      }
    },
    "betLevels": {
      "description": "Verfügbare Einsatzstufen für den Bet-Stepper.",
      "type": "array",
      "items": { "type": "number", "minimum": 1 },
      "minItems": 1
    },
    "slotMath": {
      "description": "Demo-/Referenz-Spielphysik für Paylines + Scatter-Schwelle. Der Mock-Adapter wertet damit Spins aus — Live-Server sollte eigene Mathematik setzen.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minMatchLength",
        "referenceBet",
        "scatterMinBonus",
        "scatterBonusResolutionOrder",
        "paylines",
        "lineMultipliersBySymbolId"
      ],
      "properties": {
        "minMatchLength": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "referenceBet": {
          "type": "integer",
          "minimum": 1
        },
        "scatterMinBonus": {
          "type": "integer",
          "minimum": 3,
          "maximum": 8
        },
        "scatterBonusResolutionOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["gears_clash", "heist_run", "deadlock_mode"]
          }
        },
        "paylines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rows"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": {
                "type": "string",
                "description": "Anzeigename der Gewinnlinie (z. B. 'Center Line', 'Gear Rotation Left')."
              },
              "type": {
                "type": "string",
                "enum": ["straight", "diagonal", "zigzag", "v", "industrial", "hero"],
                "description": "Visuelle Kategorie für Info-Modal-Darstellung."
              },
              "rows": {
                "type": "array",
                "minItems": 5,
                "maxItems": 10,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9
                }
              }
            }
          }
        },
        "lineMultipliersBySymbolId": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
